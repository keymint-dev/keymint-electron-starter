{
  "name": "keymint-electron-starter",
  "version": "1.0.0",
  "description": "Electron app with Keymint license activation pre-configured",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "tsc && electron .",
    "build": "tsc",
    "package": "tsc && electron-builder",
    "smoke": "node scripts/smoke.mjs",
    "test": "tsc && node --test test/offline.test.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-store": "^8.2.0",
    "keymint": "^1.7.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "typescript": "^5.3.0"
  }
}
